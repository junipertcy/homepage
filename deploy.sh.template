#!/bin/bash

# Function to display usage
function usage() {
    cat <<EOF
Usage: $0 [options]
Uploads the Angular site to AWS S3.

Options:
  -h, --help            Show this message and exit.
  -d, --delete-first    Remove specific contents in the target bucket before syncing.
  -s, --sync            Sync the local directory to the S3 bucket.
EOF
}

# AWS CloudFront Distribution ID
DISTID=""

# Check for necessary commands
if ! command -v ng &>/dev/null || ! command -v aws &>/dev/null; then
    echo "Error: This script requires both 'ng' and 'aws' commands to be available."
    exit 1
fi

# Fail fast if AWS credentials are absent or expired, instead of letting a
# failed S3 listing masquerade as "every file changed".
require_aws_credentials() {
    if ! aws sts get-caller-identity --profile default >/dev/null 2>&1; then
        echo "Error: AWS credentials are missing or expired (sts get-caller-identity failed)."
        echo "Refresh the session (e.g. 'aws sso login --profile default') and retry."
        exit 1
    fi
}

# Default action is to show usage if no arguments are passed
if [ $# -eq 0 ]; then
    usage
    exit 1
fi

# Function to determine content type based on file extension
get_mime_type() {
    local filename="$1"
    local build_dir="${2:-./dist/browser}"  # Accept build_dir as parameter with default
    local extension="${filename##*.}"  # Get everything after the last dot

    # Convert extension to lowercase for consistent matching (compatible with older bash)
    extension=$(echo "$extension" | tr '[:upper:]' '[:lower:]')

    case "$extension" in
        js|mjs)
            # Use text/javascript for ES modules (the standard MIME type)
            echo "text/javascript"
            ;;
        css)
            echo "text/css"
            ;;
        html)
            echo "text/html"
            ;;
        json)
            echo "application/json"
            ;;
        wasm)
            # If your Angular app uses WebAssembly, set application/wasm
            echo "application/wasm"
            ;;
        map)
            echo "application/json"
            ;;
        svg)
            echo "image/svg+xml"
            ;;
        png)
            echo "image/png"
            ;;
        jpg|jpeg)
            echo "image/jpeg"
            ;;
        gif)
            echo "image/gif"
            ;;
        ico)
            echo "image/x-icon"
            ;;
        pdf)
            echo "application/pdf"
            ;;
        woff)
            echo "font/woff"
            ;;
        woff2)
            echo "font/woff2"
            ;;
        ttf)
            echo "font/ttf"
            ;;
        eot)
            echo "application/vnd.ms-fontobject"
            ;;
        *)
            # Fallback to auto-detection via the 'file' command
            if [ -f "$build_dir/$filename" ]; then
                file --mime-type -b "$build_dir/$filename"
            else
                echo "application/octet-stream"
            fi
            ;;
    esac
}

# Function to determine Cache-Control based on whether the filename is content-hashed.
# Hashed build outputs (main-VFR5KSAR.js, styles-6YDRY5JP.css, chunk-*.js) can never change
# under the same name, so they are safe to cache forever. Everything else is served from a
# stable path and must be revalidated.
get_cache_control() {
    local filename="$1"

    case "$filename" in
        index.html)
            # The entry point: must always be revalidated so a new build is picked up.
            echo "no-cache"
            ;;
        *-[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9].js|*-[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9].css)
            echo "public, max-age=31536000, immutable"
            ;;
        *)
            # assets/, favicon.ico, media/ — stable paths whose contents can be replaced.
            echo "public, max-age=3600"
            ;;
    esac
}

# Function to perform sync
sync_to_s3() {
    echo "Building Angular project..."
    ng build --configuration production || {
        echo "Build failed"
        exit 1
    }

    echo "Checking for changed files..."
    # Not 'local': the EXIT trap fires after this function returns, when a local is out of scope.
    tmp_dir=$(mktemp -d) || { echo "mktemp failed"; exit 1; }
    trap 'rm -rf "$tmp_dir"' EXIT INT TERM
    local local_files_checksum="$tmp_dir/local_files_checksum.txt"
    local s3_files_metadata="$tmp_dir/s3_files_metadata.txt"
    local build_dir="./dist/browser"

    # Check if browser subdirectory exists (Angular v17+ application builder)
    if [ ! -d "$build_dir" ]; then
        build_dir="./dist"
    fi

    echo "Using build directory: $build_dir"

    # Generate list of local files and their checksums (strip build_dir prefix for S3 key matching)
    find "$build_dir" -type f -exec md5sum {} + | sed "s|$build_dir/||" | sort >"$local_files_checksum"

    # Get list of existing files in S3 and their checksums
    # Capture and check the listing explicitly: a pipeline discards the aws exit
    # code, and an empty listing makes every local file look changed (full re-upload).
    local s3_listing
    if ! s3_listing=$(aws s3api list-objects \
        --bucket junipertcy.info \
        --query "Contents[].{Key: Key, ETag: ETag}" \
        --output text \
        --profile default); then
        echo "Error: failed to list s3://junipertcy.info. Aborting before any upload."
        exit 1
    fi
    printf '%s\n' "$s3_listing" | awk '{print $1 "  " $2}' | sed 's/"//g' | sort > "$s3_files_metadata"

    # Paths that need a CloudFront invalidation: only files served from a stable path.
    # Content-hashed files get a brand-new URL each build, so the edge cache can never
    # hold a stale copy of them and invalidating them would just waste the free quota.
    local invalidation_paths=()

    # Sync files that differ by MD5 or don’t exist in S3
    while IFS= read -r line; do
        local md5=$(echo "$line" | awk '{print $1}')
        local file_path=$(echo "$line" | awk '{print $2}')
        # Anchor the match to the whole key, otherwise a key that is a substring of
        # another (e.g. "main.js" inside "vendor-main.js") picks up the wrong ETag.
        local s3_md5=$(awk -v key="$file_path" '$2 == key {print $1}' "$s3_files_metadata")

        if [[ "$md5" != "$s3_md5" ]]; then
            echo "MD5 mismatch or new file - Syncing file: $file_path: local=$md5 vs s3=$s3_md5"
            metadata=$(aws s3api head-object \
                --bucket junipertcy.info \
                --key "$file_path" \
                --query Metadata.md5checksum \
                --output text \
                --profile default 2>/dev/null)

            if [[ "$md5" != "$metadata" ]]; then
                mime_type=$(get_mime_type "$file_path" "$build_dir")
                cache_control=$(get_cache_control "$file_path")
                echo "Uploading $file_path with Content-Type: $mime_type; Cache-Control: $cache_control"
                if aws s3 cp "$build_dir/$file_path" "s3://junipertcy.info/$file_path" \
                    --acl public-read \
                    --metadata md5checksum=$md5 \
                    --content-type "$mime_type" \
                    --cache-control "$cache_control" \
                    --profile default; then
                    # Only stable paths can go stale at the edge.
                    if [[ "$cache_control" != "public, max-age=31536000, immutable" ]]; then
                        invalidation_paths+=("/$file_path")
                    fi
                else
                    echo "Failed to sync $file_path"
                fi
            else
                echo "Yet, metadata match - No need to sync: $file_path"
            fi
        fi
    done <"$local_files_checksum"

    # Invalidate CloudFront cache for the changed stable paths only
    if [ ${#invalidation_paths[@]} -eq 0 ]; then
        echo "No stable paths changed - skipping CloudFront invalidation."
    elif [ ${#invalidation_paths[@]} -gt 100 ]; then
        # A wildcard counts as one path against the 1000/month free quota, and beyond
        # ~100 individual paths it is both cheaper and faster than listing them.
        echo "Invalidating CloudFront distribution (${#invalidation_paths[@]} paths changed - using wildcard)..."
        aws cloudfront create-invalidation \
            --distribution-id $DISTID \
            --paths "/*" \
            --profile default \
            || echo "Failed to invalidate CloudFront distribution"
    else
        echo "Invalidating CloudFront distribution (${#invalidation_paths[@]} path(s))..."
        aws cloudfront create-invalidation \
            --distribution-id $DISTID \
            --paths "${invalidation_paths[@]}" \
            --profile default \
            || echo "Failed to invalidate CloudFront distribution"
    fi

    echo "Sync completed."
}

# Parse options
while getopts ":hds" option; do
    case "${option}" in
    h)
        usage
        exit 0
        ;;
    d)
        require_aws_credentials
        # Remove specific contents before syncing
        echo "Removing old build artifacts from S3..."
        aws s3 rm s3://junipertcy.info --recursive \
            --exclude "*" \
            --include "*.js" \
            --include "*.css" \
            --include "*.eot" \
            --include "*.woff" \
            --include "*.woff2" \
            --profile default
        # Also remove the browser/ subdirectory if it exists
        aws s3 rm s3://junipertcy.info/browser/ --recursive --profile default 2>/dev/null || true
        sync_to_s3
        exit 0
        ;;
    s)
        require_aws_credentials
        sync_to_s3
        exit 0
        ;;
    *)
        usage
        exit 1
        ;;
    esac
done

# Shift off the options
shift $((OPTIND - 1))

# If no options were passed, show usage
if [ $# -eq 0 ]; then
    usage
    exit 1
fi
