#!/bin/bash

# Function to display usage
function usage() {
    cat <<EOF
Usage: $0 [options]
Uploads the Angular site to AWS S3.

Options:
  -h, --help            Show this message and exit.
  -d, --delete-stale    Sync, then delete old build files the new build no longer uses.
  -s, --sync            Sync the local directory to the S3 bucket.
EOF
}

# AWS CloudFront Distribution ID
DISTID=""

# AWS profile for deploys: role junipertcy-info-deploy, scoped to this bucket and
# distribution, assumed with an access key kept in the macOS Keychain.
PROFILE="junipertcy-info-deploy"

# Check for necessary commands
if ! command -v ng &>/dev/null || ! command -v aws &>/dev/null; then
    echo "Error: This script requires both 'ng' and 'aws' commands to be available."
    exit 1
fi

# Fail fast if AWS credentials are absent or expired, instead of letting a
# failed S3 listing masquerade as "every file changed".
require_aws_credentials() {
    local sts_error
    if ! sts_error=$(aws sts get-caller-identity --profile "$PROFILE" 2>&1 >/dev/null); then
        echo "Error: no working AWS credentials for profile '$PROFILE':"
        echo "$sts_error" | sed 's/^/  /'
        echo "Check that '$PROFILE' is set up in ~/.aws/config and that the Keychain item"
        echo "'aws-junipertcy-info-deploy' holds the deploy user's access key."
        exit 1
    fi
}

# Default action is to show usage if no arguments are passed
if [ $# -eq 0 ]; then
    usage
    exit 1
fi

# Function to determine content type based on file extension
get_mime_type() {
    local filename="$1"
    local build_dir="${2:-./dist/browser}"  # Accept build_dir as parameter with default
    local extension="${filename##*.}"  # Get everything after the last dot

    # Convert extension to lowercase for consistent matching (compatible with older bash)
    extension=$(echo "$extension" | tr '[:upper:]' '[:lower:]')

    case "$extension" in
        js|mjs)
            # Use text/javascript for ES modules (the standard MIME type)
            echo "text/javascript"
            ;;
        css)
            echo "text/css"
            ;;
        html)
            echo "text/html"
            ;;
        json)
            echo "application/json"
            ;;
        wasm)
            # If your Angular app uses WebAssembly, set application/wasm
            echo "application/wasm"
            ;;
        map)
            echo "application/json"
            ;;
        svg)
            echo "image/svg+xml"
            ;;
        png)
            echo "image/png"
            ;;
        jpg|jpeg)
            echo "image/jpeg"
            ;;
        gif)
            echo "image/gif"
            ;;
        ico)
            echo "image/x-icon"
            ;;
        pdf)
            echo "application/pdf"
            ;;
        woff)
            echo "font/woff"
            ;;
        woff2)
            echo "font/woff2"
            ;;
        ttf)
            echo "font/ttf"
            ;;
        eot)
            echo "application/vnd.ms-fontobject"
            ;;
        *)
            # Fallback to auto-detection via the 'file' command
            if [ -f "$build_dir/$filename" ]; then
                file --mime-type -b "$build_dir/$filename"
            else
                echo "application/octet-stream"
            fi
            ;;
    esac
}

# Content-hashed build output can never change under the same name, so it is safe to cache
# forever and never needs invalidating: the root-level bundles (main-2HHGA7ZG.js,
# chunk-BBk_kAyy.js, styles-I6FAHMI4.css) and everything the builder writes to media/
# (fonts, icon sets). assets/ is copied verbatim, so a name like photo-20260101.jpg there
# is not a hash.
is_hashed_build_output() {
    local key="$1"
    local hashed_bundle='-[A-Za-z0-9_-]{8}\.(js|css)$'

    case "$key" in
        media/*) return 0 ;;
        */*) return 1 ;;
    esac
    [[ "$key" =~ $hashed_bundle ]]
}

# Function to determine Cache-Control for a key.
get_cache_control() {
    local filename="$1"

    if [[ "$filename" == *.html ]]; then
        # Every page (index.html, each prerendered route's index.html, index.csr.html) names the
        # bundles of its build, so it must be revalidated for a new build to be picked up.
        echo "no-cache"
    elif is_hashed_build_output "$filename"; then
        echo "public, max-age=31536000, immutable"
    else
        # assets/, favicon.ico, sitemap.xml — stable paths whose contents can be replaced.
        echo "public, max-age=3600"
    fi
}

# Print the checksum list with every HTML file moved to the end. Pages are uploaded last, so a
# live page never references a bundle that has not been uploaded yet.
order_for_upload() {
    grep -v '\.html$' "$1"
    grep '\.html$' "$1"
}

# Function to perform sync. Returns non-zero if any upload or the invalidation failed.
sync_to_s3() {
    echo "Building Angular project..."
    ng build --configuration production || {
        echo "Build failed"
        exit 1
    }

    echo "Checking for changed files..."
    # Not 'local': the EXIT trap fires after this function returns, when a local is out of scope.
    tmp_dir=$(mktemp -d) || { echo "mktemp failed"; exit 1; }
    trap 'rm -rf "$tmp_dir"' EXIT
    # A signal handler that does not exit lets bash RESUME the script with the temp files
    # already deleted — the upload loop would then re-upload everything and exit 0.
    trap 'echo "Interrupted."; exit 130' INT TERM
    local local_files_checksum="$tmp_dir/local_files_checksum.txt"
    local s3_files_metadata="$tmp_dir/s3_files_metadata.txt"
    local upload_list="$tmp_dir/upload_list.txt"
    # Not 'local': prune_stale_build_output reads it after this function returns.
    build_dir="./dist/browser"

    # Check if browser subdirectory exists (Angular v17+ application builder)
    if [ ! -d "$build_dir" ]; then
        build_dir="./dist"
    fi

    echo "Using build directory: $build_dir"

    # Generate list of local files and their checksums (strip build_dir prefix for S3 key matching)
    find "$build_dir" -type f -exec md5sum {} + | sed "s|$build_dir/||" | sort >"$local_files_checksum"
    # The pipeline hides md5sum failures. A short list would upload nothing, report success,
    # and let -d delete the bundles the live index.html still references.
    if (( $(wc -l <"$local_files_checksum") != $(find "$build_dir" -type f | wc -l) )); then
        echo "Error: could not checksum every file in $build_dir. Aborting before any upload."
        exit 1
    fi

    # Get list of existing files in S3 and their checksums
    # Capture and check the listing explicitly: a pipeline discards the aws exit
    # code, and an empty listing makes every local file look changed (full re-upload).
    local s3_listing
    if ! s3_listing=$(aws s3api list-objects \
        --bucket junipertcy.info \
        --query "Contents[].{Key: Key, ETag: ETag}" \
        --output text \
        --profile "$PROFILE"); then
        echo "Error: failed to list s3://junipertcy.info. Aborting before any upload."
        exit 1
    fi
    printf '%s\n' "$s3_listing" | awk '{print $1 "  " $2}' | sed 's/"//g' | sort > "$s3_files_metadata"

    # Paths that need a CloudFront invalidation: only files served from a stable path.
    # Content-hashed files get a brand-new URL each build, so the edge cache can never
    # hold a stale copy of them and invalidating them would just waste the free quota.
    local invalidation_paths=()
    local failed_uploads=()
    local uploaded_count=0
    local html_skipped=0
    local invalidation_failed=0

    order_for_upload "$local_files_checksum" >"$upload_list"

    # Sync files that differ by MD5 or don’t exist in S3
    while IFS= read -r line; do
        local md5=$(echo "$line" | awk '{print $1}')
        local file_path=$(echo "$line" | awk '{print $2}')
        # Anchor the match to the whole key, otherwise a key that is a substring of
        # another (e.g. "main.js" inside "vendor-main.js") picks up the wrong ETag.
        local s3_md5=$(awk -v key="$file_path" '$2 == key {print $1}' "$s3_files_metadata")

        if [[ "$md5" != "$s3_md5" ]]; then
            echo "MD5 mismatch or new file - Syncing file: $file_path: local=$md5 vs s3=$s3_md5"
            metadata=$(aws s3api head-object \
                --bucket junipertcy.info \
                --key "$file_path" \
                --query Metadata.md5checksum \
                --output text \
                --profile "$PROFILE" 2>/dev/null)

            if [[ "$md5" != "$metadata" ]]; then
                if [[ "$file_path" == *.html ]] && [ ${#failed_uploads[@]} -gt 0 ]; then
                    # Publishing a page now could point it at bundles that failed to upload.
                    echo "Skipping $file_path: ${#failed_uploads[@]} earlier upload(s) failed."
                    html_skipped=$((html_skipped + 1))
                    continue
                fi
                mime_type=$(get_mime_type "$file_path" "$build_dir")
                cache_control=$(get_cache_control "$file_path")
                echo "Uploading $file_path with Content-Type: $mime_type; Cache-Control: $cache_control"
                if aws s3 cp "$build_dir/$file_path" "s3://junipertcy.info/$file_path" \
                    --metadata md5checksum=$md5 \
                    --content-type "$mime_type" \
                    --cache-control "$cache_control" \
                    --profile "$PROFILE"; then
                    uploaded_count=$((uploaded_count + 1))
                    # Only stable paths can go stale at the edge.
                    if [[ "$cache_control" != "public, max-age=31536000, immutable" ]]; then
                        invalidation_paths+=("/$file_path")
                    fi
                else
                    echo "Failed to sync $file_path"
                    failed_uploads+=("$file_path")
                fi
            else
                echo "Yet, metadata match - No need to sync: $file_path"
            fi
        fi
    done <"$upload_list"

    # Invalidate CloudFront cache for the changed stable paths only
    local invalidation_summary
    if [ ${#invalidation_paths[@]} -eq 0 ]; then
        echo "No stable paths changed - skipping CloudFront invalidation."
        invalidation_summary="0 paths invalidated"
    elif [ ${#invalidation_paths[@]} -gt 100 ]; then
        # A wildcard counts as one path against the 1000/month free quota, and beyond
        # ~100 individual paths it is both cheaper and faster than listing them.
        echo "Invalidating CloudFront distribution (${#invalidation_paths[@]} paths changed - using wildcard)..."
        aws cloudfront create-invalidation \
            --distribution-id "$DISTID" \
            --paths "/*" \
            --profile "$PROFILE" \
            || { echo "Failed to invalidate CloudFront distribution"; invalidation_failed=1; }
        invalidation_summary="all paths invalidated (wildcard)"
    else
        echo "Invalidating CloudFront distribution (${#invalidation_paths[@]} path(s))..."
        aws cloudfront create-invalidation \
            --distribution-id "$DISTID" \
            --paths "${invalidation_paths[@]}" \
            --profile "$PROFILE" \
            || { echo "Failed to invalidate CloudFront distribution"; invalidation_failed=1; }
        invalidation_summary="${#invalidation_paths[@]} path(s) invalidated"
    fi

    if [ ${#failed_uploads[@]} -gt 0 ] || [ "$invalidation_failed" -eq 1 ]; then
        echo "FAILED: the deploy is incomplete."
        local f
        for f in "${failed_uploads[@]}"; do
            echo "  upload failed: $f"
        done
        if [ "$html_skipped" -gt 0 ]; then
            echo "  $html_skipped page(s) were NOT uploaded, so the live site still serves the previous build's pages."
        fi
        if [ "$invalidation_failed" -eq 1 ]; then
            echo "  CloudFront invalidation failed: changed pages may be served stale until their cache expires."
        fi
        return 1
    fi

    echo "Deployed: $uploaded_count file(s) uploaded, $invalidation_summary."
}

# After a successful sync, delete build output that the new build no longer uses: stale
# hashed bundles and the legacy browser/ prefix. Hand-uploaded files and assets/ are never
# candidates. The bucket is versioned, so every deletion is recoverable for 30 days.
prune_stale_build_output() {
    local local_keys="$tmp_dir/local_keys.txt"
    local s3_keys="$tmp_dir/s3_keys.txt"

    find "$build_dir" -type f | sed "s|^$build_dir/||" | sort >"$local_keys"
    if ! grep -qx 'index\.html' "$local_keys"; then
        echo "Error: $build_dir has no index.html - refusing to delete anything."
        return 1
    fi

    echo "Looking for stale build output in s3://junipertcy.info..."
    local s3_listing
    if ! s3_listing=$(aws s3api list-objects \
        --bucket junipertcy.info \
        --query "Contents[].[Key]" \
        --output text \
        --profile "$PROFILE"); then
        echo "Error: failed to list s3://junipertcy.info. Nothing deleted."
        return 1
    fi
    printf '%s\n' "$s3_listing" >"$s3_keys"

    local key
    local deleted_count=0
    local failed_deletes=0
    while IFS= read -r key; do
        case "$key" in
            browser/*) ;;
            *) is_hashed_build_output "$key" || continue ;;
        esac
        grep -qxF -- "$key" "$local_keys" && continue
        if aws s3 rm "s3://junipertcy.info/$key" --profile "$PROFILE"; then
            deleted_count=$((deleted_count + 1))
        else
            echo "Failed to delete $key"
            failed_deletes=$((failed_deletes + 1))
        fi
    done <"$s3_keys"

    if [ "$failed_deletes" -gt 0 ]; then
        echo "FAILED: $failed_deletes stale file(s) could not be deleted ($deleted_count deleted)."
        return 1
    fi
    echo "Cleanup: $deleted_count stale file(s) deleted."
}

# Parse options
while getopts ":hds" option; do
    case "${option}" in
    h)
        usage
        exit 0
        ;;
    d)
        require_aws_credentials
        # Delete stale build output only once the new build is fully live.
        sync_to_s3 || exit 1
        prune_stale_build_output || exit 1
        exit 0
        ;;
    s)
        require_aws_credentials
        sync_to_s3 || exit 1
        exit 0
        ;;
    *)
        usage
        exit 1
        ;;
    esac
done

# Shift off the options
shift $((OPTIND - 1))

# If no options were passed, show usage
if [ $# -eq 0 ]; then
    usage
    exit 1
fi
